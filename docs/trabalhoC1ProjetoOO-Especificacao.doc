\pard\intbl\fs18 Arquitetura de sistema\cell
\pard\intbl\fs18 {\b Cliente-servidor em 3 camadas f\'edsicas}\cell
\pard\intbl\fs18 O jogo \'e9 competitivo e online: as regras precisam ser aplicadas em um ponto confi\'e1vel, fora do alcance do jogador, o que inviabiliza uma arquitetura puramente local.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx3023\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx6046\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9069
\pard\intbl\fs18 Arquitetura de software (macro)\cell
\pard\intbl\fs18 {\b Camadas (layered) \'97 MVC-P}\cell
\pard\intbl\fs18 Exigido pela disciplina e adequado \'e0 separa\'e7\'e3o entre apresenta\'e7\'e3o, controle, dom\'ednio e persist\'eancia, favorecendo a manuten\'e7\'e3o e o teste isolado das regras.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx3023\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx6046\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9069
\pard\intbl\fs18 Arquitetura de software (comunica\'e7\'e3o)\cell
\pard\intbl\fs18 {\b Cliente-servidor com servi\'e7os REST + WebSocket}\cell
\pard\intbl\fs18 REST atende \'e0s opera\'e7\'f5es de cadastro, cole\'e7\'e3o e deck; WebSocket atende \'e0 partida, que exige comunica\'e7\'e3o bidirecional e de baixa lat\'eancia entre os dois jogadores.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx3023\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx6046\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9069
\pard\intbl\fs18 Persist\'eancia\cell
\pard\intbl\fs18 {\b Reposit\'f3rio (DAO) sobre SGBD relacional}\cell
\pard\intbl\fs18 Isola o dom\'ednio da tecnologia de banco, permitindo trocar o SGBD sem alterar o modelo.\cell
\row
