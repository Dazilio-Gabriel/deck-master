\pard\intbl\fs18 \b Decis\'e3o\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Distribui\'e7\'e3o geogr\'e1fica dos requisitos computacionais\cell
\pard\intbl\fs18 Processamento das regras e dos dados centralizado na regi\'e3o AWS {\f1\fs15 sa-east-1} (S\'e3o Paulo). Apenas a apresenta\'e7\'e3o \'e9 distribu\'edda, executando na m\'e1quina de cada jogador.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Componentes de hardware \'97 m\'e1quinas clientes\cell
\pard\intbl\fs18 Processador dual-core 2.0 GHz, 4 GB de RAM, 2 GB de disco livre, placa de v\'eddeo com suporte a OpenGL 2.0, resolu\'e7\'e3o m\'ednima 1366\'d7768 e conex\'e3o de 5 Mbps.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Componentes de hardware \'97 m\'e1quinas servidoras\cell
\pard\intbl\fs18 2 inst\'e2ncias de aplica\'e7\'e3o (4 vCPU, 8 GB RAM, 50 GB SSD) atr\'e1s de balanceador de carga; 1 inst\'e2ncia de banco (4 vCPU, 16 GB RAM, 200 GB SSD com IOPS provisionado) com r\'e9plica de leitura.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Configura\'e7\'e3o e n\'famero de camadas cliente-servidor\cell
\pard\intbl\fs18 Tr\'eas camadas f\'edsicas: cliente de apresenta\'e7\'e3o, servidor de aplica\'e7\'e3o e servidor de banco de dados.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Plataforma de software de implementa\'e7\'e3o\cell
\pard\intbl\fs18 Linguagem {\b Java 21}; interface com o usu\'e1rio em {\b JavaFX 21}; servi\'e7os em {\b Spring Boot 3}; comunica\'e7\'e3o em {\b HTTPS/REST (JSON)} e {\b WebSocket (WSS)}; sistema operacional dos servidores {\b Ubuntu Server 24.04 LTS}; clientes em {\b Windows 10/11, macOS 13+ e Ubuntu 22.04+}; SGBD {\b PostgreSQL 16}; acesso a dados via {\b JDBC}.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Localiza\'e7\'e3o dos processos\cell
\pard\intbl\fs18 Regras de neg\'f3cio, valida\'e7\'e3o de decks, sorteio de cartas e apura\'e7\'e3o de ranking executam exclusivamente no servidor. O cliente executa apenas renderiza\'e7\'e3o, captura de comandos e valida\'e7\'f5es de preenchimento de formul\'e1rio.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Localiza\'e7\'e3o dos dados f\'edsicos\cell
\pard\intbl\fs18 Base \'fanica centralizada no servidor de banco na nuvem. O cliente mant\'e9m apenas cache local tempor\'e1rio de imagens de cartas e das prefer\'eancias de interface.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Estrat\'e9gias de sincroniza\'e7\'e3o de dados distribu\'eddos\cell
\pard\intbl\fs18 N\'e3o h\'e1 dados de neg\'f3cio distribu\'eddos geograficamente, o que elimina a necessidade de sincroniza\'e7\'e3o entre bases. A r\'e9plica de leitura \'e9 sincronizada por replica\'e7\'e3o nativa em modo streaming ass\'edncrono e \'e9 usada apenas para consultas de ranking e hist\'f3rico.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Computa\'e7\'e3o em nuvem ou servidores locais\cell
\pard\intbl\fs18 {\b Computa\'e7\'e3o em nuvem} (AWS), pela elasticidade necess\'e1ria ao pico de jogadores simult\'e2neos e por dispensar investimento inicial em infraestrutura.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Desenvolvimento local ou em nuvem\cell
\pard\intbl\fs18 {\b Desenvolvimento em m\'e1quinas locais} com IntelliJ IDEA, banco PostgreSQL em cont\'eainer Docker e versionamento em reposit\'f3rio Git remoto; a integra\'e7\'e3o e a implanta\'e7\'e3o s\'e3o automatizadas na nuvem.\cell
\row
\pard\sa120\par
\pard\sa120\par
\pard\ql\sb240\sa120\b\fs28 5 \'97 PROJETO DE ARQUITETURA DO SOFTWARE: DIAGRAMA DE PACOTES\b0\fs24\par
\pard\qj\sa120 A organiza\'e7\'e3o adotada combina as duas alternativas propostas por Magela (1998): a divis\'e3o de primeiro n\'edvel segue os {\b estere\'f3tipos} do MVC-P (view, controller, model, persistence) e, dentro de {\f1\fs21 model}, {\f1\fs21 controller} e {\f1\fs21 persistence}, a divis\'e3o de segundo n\'edvel segue o {\b dom\'ednio do problema} (conta, carta, colecao, deck, partida, competicao, seguranca).\par
