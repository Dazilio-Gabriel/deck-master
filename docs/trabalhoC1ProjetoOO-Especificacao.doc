\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Adquirir pacotes de cartas usando cristais.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Jogador autenticado e pacote ativo na loja.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Saldo de cristais debitado e pacotes creditados ao jogador.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador acessa a loja.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta os pacotes ativos, com nome, expans\'e3o, quantidade de cartas e pre\'e7o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador seleciona um pacote e informa a quantidade.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema calcula o custo total e apresenta a confirma\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador confirma.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica o saldo de cristais.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema debita o saldo e registra a compra.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Saldo insuficiente:} informa o valor faltante e retorna ao passo 3.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Pacote desativado durante a opera\'e7\'e3o:} informa a indisponibilidade e retorna ao passo 2.\par
\pard\ql\sb240\sa120\b\fs26 CDU-03 \'97 AbrirPacote\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Revelar as cartas contidas em um pacote adquirido e incorpor\'e1-las \'e0 cole\'e7\'e3o.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 O jogador possui ao menos um pacote n\'e3o aberto.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Cartas sorteadas incorporadas \'e0 cole\'e7\'e3o; abertura registrada no hist\'f3rico.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador seleciona um pacote n\'e3o aberto e solicita a abertura.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema sorteia a quantidade de cartas definida no pacote, respeitando a probabilidade de\par
\pard\qj\sa120 cada raridade e garantindo ao menos uma carta rara ou superior.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica, para cada carta sorteada, se o jogador j\'e1 a possui.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema incrementa a quantidade na cole\'e7\'e3o ou cria o item de cole\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema registra a abertura e as cartas sorteadas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta as cartas obtidas, destacando as in\'e9ditas.\par
\pard\qj\sa120 {\b Fluxos alternativos}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b A1 \'96 Limite de c\'f3pias atingido:} no passo 4, se o jogador j\'e1 possui o n\'famero m\'e1ximo de c\'f3pias\par
\pard\qj\sa120 permitido, o sistema converte a carta em fragmentos automaticamente e informa o jogador.\par
\pard\ql\sb240\sa120\b\fs26 CDU-04 \'97 EditarDeck\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Alterar a composi\'e7\'e3o de um deck, respeitando as regras do formato e a posse das cartas.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 O deck pertence ao jogador autenticado.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Deck gravado com a nova composi\'e7\'e3o e com o totalizador de cartas atualizado.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador seleciona um deck e solicita a edi\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta a cole\'e7\'e3o do jogador de um lado e a composi\'e7\'e3o atual do deck do outro.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador adiciona ou remove cartas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab Para cada adi\'e7\'e3o, o sistema verifica se o jogador possui a quantidade de c\'f3pias pretendida e se\par
\pard\qj\sa120 o limite de c\'f3pias do formato \'e9 respeitado.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema atualiza o totalizador de cartas e exibe o progresso em rela\'e7\'e3o ao m\'ednimo do formato.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador solicita a grava\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema executa {\i ValidarDeck}.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema grava o deck e a data da \'faltima altera\'e7\'e3o.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Carta n\'e3o possu\'edda em quantidade suficiente:} informa a quantidade dispon\'edvel e ignora a\par
\pard\qj\sa120 adi\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Deck inv\'e1lido na grava\'e7\'e3o:} apresenta a lista de erros e retorna ao passo 3.\par
\pard\ql\sb240\sa120\b\fs26 CDU-05 \'97 ValidarDeck\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 \'97 (caso de uso inclu\'eddo por CriarDeck e EditarDeck)\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Verificar se um deck atende \'e0s regras do seu formato.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Deck com formato definido.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Resultado da valida\'e7\'e3o produzido, com a lista de erros e de avisos.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema conta o total de cartas do deck.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se o total est\'e1 entre o m\'ednimo e o m\'e1ximo do formato.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica, carta a carta, se a quantidade de c\'f3pias n\'e3o excede o m\'e1ximo do formato.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se o jogador ainda possui todas as cartas do deck na quantidade utilizada.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema produz o resultado da valida\'e7\'e3o.\par
\pard\ql\sb240\sa120\b\fs26 CDU-06 \'97 SolicitarPartida\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Colocar o jogador em uma fila at\'e9 que um oponente compat\'edvel seja encontrado e iniciar a partida.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 O jogador possui ao menos um deck v\'e1lido.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partida criada com situa\'e7\'e3o "Em Andamento" e dois participantes registrados.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador escolhe o modo (casual ou ranqueada) e o deck.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema executa {\i ValidarDeck}.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema insere o jogador na fila de espera do modo escolhido.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema procura um oponente com pontua\'e7\'e3o pr\'f3xima, no caso de partida ranqueada.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab Ao encontrar o oponente, o sistema cria a partida com situa\'e7\'e3o "Aguardando Oponente" e registra\par
\pard\qj\sa120 as duas participa\'e7\'f5es.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema sorteia quem inicia, distribui a m\'e3o inicial de 7 cartas a cada lado e altera a\par
\pard\qj\sa120 situa\'e7\'e3o para "Em Andamento".\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema abre a mesa de partida para os dois jogadores.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Deck inv\'e1lido:} apresenta os erros e encerra o caso de uso.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Tempo de espera esgotado (5 minutos):} o sistema retira o jogador da fila, cancela a\par
\pard\qj\sa120 busca e informa que nenhum oponente foi encontrado.\par
\pard\ql\sb240\sa120\b\fs26 CDU-07 \'97 RealizarJogada\b0\fs24\par
