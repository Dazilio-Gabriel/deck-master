\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Usu\'e1rio autenticado, ou em fluxo de senha expirada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Nova senha armazenada de forma cifrada e data de expira\'e7\'e3o recalculada.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O usu\'e1rio solicita a altera\'e7\'e3o de senha.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema solicita a senha atual, a nova senha e a confirma\'e7\'e3o da nova senha.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O usu\'e1rio informa os dados e confirma.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema valida a senha atual.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema valida a nova senha quanto \'e0 pol\'edtica de senhas (m\'ednimo de 8 caracteres, ao menos\par
\pard\qj\sa120 uma letra e um n\'famero, diferente das 3 \'faltimas utilizadas).\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema grava o novo resumo criptogr\'e1fico e confirma a opera\'e7\'e3o.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Senha atual incorreta:} informa o erro e retorna ao passo 2.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Nova senha fora da pol\'edtica ou divergente da confirma\'e7\'e3o:} informa o erro e retorna ao\par
\pard\qj\sa120 passo 2.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T03 \'97 CadastrarPerfilAcesso\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
