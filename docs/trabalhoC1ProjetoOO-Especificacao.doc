\pard\ql\sb240\sa120\b\fs28 ANEXO III \'97 DESCRI\'c7\'d5ES DOS CASOS DE USO (AN\'c1LISE)\b0\fs24\par
\pard\ql\sb240\sa120\b\fs26 CDU-01 \'97 CadastrarJogador\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Registrar uma nova pessoa no jogo, criando sua conta, seu saldo inicial de cristais e sua cole\'e7\'e3o inicial de cartas.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 O apelido e o e-mail informados ainda n\'e3o est\'e3o em uso.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Jogador cadastrado, com 500 cristais, o deck inicial e a cole\'e7\'e3o inicial de 30 cartas comuns.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab A pessoa solicita a cria\'e7\'e3o de conta.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema solicita apelido, nome completo, e-mail, data de nascimento, endere\'e7o, telefone,\par
\pard\qj\sa120 login e senha.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab A pessoa informa os dados e confirma.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema valida o formato do e-mail e a idade m\'ednima de 13 anos.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica que o apelido, o e-mail e o login ainda n\'e3o est\'e3o em uso.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema grava o jogador e o usu\'e1rio correspondente.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema credita 500 cristais e concede a cole\'e7\'e3o inicial de cartas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema monta um deck inicial v\'e1lido com as cartas concedidas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema confirma o cadastro e apresenta a tela de logon.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Apelido, e-mail ou login j\'e1 em uso:} informa qual campo est\'e1 duplicado e retorna ao passo 2.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Idade inferior a 13 anos:} informa a restri\'e7\'e3o e encerra o caso de uso.\par
\pard\ql\sb240\sa120\b\fs26 CDU-02 \'97 ComprarPacote\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
