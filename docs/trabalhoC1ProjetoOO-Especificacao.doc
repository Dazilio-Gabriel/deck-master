\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Temporizador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Transferir para a base hist\'f3rica as partidas encerradas h\'e1 mais de 90 dias, mantendo o desempenho da base operacional e preservando os dados para consulta e estat\'edstica.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Existir base hist\'f3rica dispon\'edvel.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partidas, turnos e jogadas antigas movidos para a base hist\'f3rica e removidos da base operacional.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O temporizador dispara a rotina no primeiro dia de cada m\'eas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema seleciona as partidas com situa\'e7\'e3o "Encerrada" e data de fim anterior a 90 dias.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema copia as partidas e suas participa\'e7\'f5es, turnos e jogadas para a base hist\'f3rica.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema confere a quantidade de registros copiados.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema exclui os registros da base operacional e registra o total no log.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Diverg\'eancia na confer\'eancia:} o sistema desfaz a transa\'e7\'e3o, n\'e3o exclui nada da base\par
\pard\qj\sa120 operacional e notifica o administrador.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T06 \'97 EfetuarLimpezaPartidasAbandonadas\b0\fs24\par
