\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Situa\'e7\'e3o\b0\cell
\pard\intbl\fs18 \b Solu\'e7\'e3o adotada\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Identidade dos objetos\cell
\pard\intbl\fs18 Toda tabela recebe uma chave prim\'e1ria artificial (IDO), do tipo {\f1\fs15 SERIAL}, sem significado de neg\'f3cio.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Relacionamento 1:1 ({\f1\fs15 Jogador}\'96{\f1\fs15 Endereco}, {\f1\fs15 Jogador}\'96{\f1\fs15 Usuario})\cell
\pard\intbl\fs18 Chave estrangeira no lado dependente, com restri\'e7\'e3o {\f1\fs15 UNIQUE}.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Relacionamento 1:N ({\f1\fs15 Jogador}\'96{\f1\fs15 Deck}, {\f1\fs15 Partida}\'96{\f1\fs15 Turno})\cell
\pard\intbl\fs18 Chave estrangeira na tabela do lado N.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Relacionamento N:N com atributos (classes de associa\'e7\'e3o)\cell
\pard\intbl\fs18 Tabela pr\'f3pria com chave prim\'e1ria artificial, duas chaves estrangeiras e os atributos da associa\'e7\'e3o, mais restri\'e7\'e3o {\f1\fs15 UNIQUE} no par de chaves.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Relacionamento N:N sem atributos ({\f1\fs15 Carta}\'96{\f1\fs15 Elemento})\cell
\pard\intbl\fs18 Tabela associativa {\f1\fs15 carta_elemento} com chave prim\'e1ria composta pelas duas chaves estrangeiras.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Generaliza\'e7\'e3o/especializa\'e7\'e3o ({\f1\fs15 Carta})\cell
\pard\intbl\fs18 {\b Uma tabela para a superclasse e uma tabela para cada subclasse} ({\i map classes to tables}). A tabela {\f1\fs15 carta} guarda os atributos comuns e um discriminador {\f1\fs15 tipo_carta}; {\f1\fs15 criatura}, {\f1\fs15 feitico} e {\f1\fs15 terreno} guardam os atributos pr\'f3prios e t\'eam como chave prim\'e1ria a mesma chave de {\f1\fs15 carta}. Escolhida por n\'e3o gerar colunas nulas e manter a integridade referencial \'fanica para qualquer carta.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Atributo multivalorado ({\f1\fs15 telefone*})\cell
\pard\intbl\fs18 Tabela {\f1\fs15 telefone} com chave estrangeira para {\f1\fs15 jogador}.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 Enumera\'e7\'f5es do dom\'ednio (raridade, elemento, formato, divis\'e3o, status)\cell
\pard\intbl\fs18 Tabelas de cadastro pr\'f3prias, permitindo manuten\'e7\'e3o pelo administrador sem altera\'e7\'e3o de c\'f3digo.\cell
\row
