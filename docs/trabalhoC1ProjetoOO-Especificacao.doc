\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Temporizador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Encerrar automaticamente as partidas que ficaram paradas al\'e9m do tempo limite, liberando os jogadores e mantendo a base consistente.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 \'97\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partidas com situa\'e7\'e3o "Em Andamento" ou "Pausada" h\'e1 mais de 30 minutos sem jogadas passam para "Encerrada", com derrota por aus\'eancia para o jogador inativo.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O temporizador dispara a rotina a cada 5 minutos.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema seleciona as partidas sem jogadas h\'e1 mais de 30 minutos.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab Para cada partida, o sistema identifica o jogador inativo e o declara perdedor por aus\'eancia.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema altera a situa\'e7\'e3o da partida para "Encerrada".\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab Se a partida for ranqueada, o sistema aciona {\i AtualizarPontuacaoTemporada}.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema registra a opera\'e7\'e3o no log.\par
\pard\sa120\par
\pard\ql\sb240\sa120\b\fs28 4 \'97 PROJETO DE ARQUITETURA DO SISTEMA\b0\fs24\par
