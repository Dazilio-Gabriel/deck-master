\pard\ql\sb240\sa120\b\fs28 3 \'97 DESCRI\'c7\'c3O DE CASOS DE USO DE PROJETO\b0\fs24\par
\pard\qj\sa120 Descri\'e7\'e3o dos casos de uso tecnol\'f3gicos de n\'edvel m\'ednimo, no padr\'e3o UML utilizado no trabalho de An\'e1lise OO.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T01 \'97 EfetuarLogonSistema\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador / Administrador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Identificar, autenticar e autorizar o usu\'e1rio, liberando o acesso \'e0s fun\'e7\'f5es compat\'edveis com o seu perfil.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 O usu\'e1rio possui conta cadastrada e ativa no sistema.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Sess\'e3o criada, perfil de acesso carregado e data do \'faltimo acesso atualizada.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O usu\'e1rio solicita o acesso ao sistema.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta a tela de logon solicitando login e senha.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O usu\'e1rio informa login e senha e confirma.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema localiza o usu\'e1rio pelo login.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema calcula o resumo criptogr\'e1fico da senha informada e o compara com o armazenado.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se o usu\'e1rio est\'e1 ativo.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema carrega o perfil de acesso e as fun\'e7\'f5es autorizadas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema registra a data e a hora do acesso e abre a tela principal.\par
\pard\qj\sa120 {\b Fluxos alternativos}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b A1 \'96 Senha expirada:} no passo 6, se a senha estiver expirada, o sistema desvia para o caso\par
\pard\qj\sa120 de uso {\i EfetuarAlteracaoSenha} e retorna ao passo 7.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Login inexistente:} o sistema informa "usu\'e1rio ou senha inv\'e1lidos" e retorna ao passo 2.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Senha inv\'e1lida:} o sistema incrementa o contador de tentativas, informa "usu\'e1rio ou\par
\pard\qj\sa120 senha inv\'e1lidos" e retorna ao passo 2. Ap\'f3s 5 tentativas consecutivas, a conta \'e9 bloqueada.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E3 \'96 Usu\'e1rio inativo/bloqueado:} o sistema informa a situa\'e7\'e3o e encerra o caso de uso.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T02 \'97 EfetuarAlteracaoSenha\b0\fs24\par
