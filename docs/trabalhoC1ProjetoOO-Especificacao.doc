\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Executar uma a\'e7\'e3o dentro do turno: invocar criatura, lan\'e7ar feiti\'e7o, posicionar terreno ou atacar.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partida em andamento e o jogador \'e9 o dono do turno corrente.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Jogada registrada e estado da mesa atualizado para os dois jogadores.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O jogador seleciona uma carta da m\'e3o ou uma criatura em campo e indica a a\'e7\'e3o e o alvo.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se o jogador \'e9 o dono do turno corrente.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se os recursos dispon\'edveis cobrem o custo da carta.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se o alvo \'e9 permitido para a carta escolhida.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema aplica o efeito da jogada e debita os recursos.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema registra a jogada no turno e atualiza a data da \'faltima jogada da partida.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema verifica se a partida terminou; em caso afirmativo, executa {\i EncerrarPartida}.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema envia o novo estado da mesa aos dois jogadores.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 N\'e3o \'e9 o turno do jogador:} a jogada \'e9 recusada e o estado permanece inalterado.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Recursos insuficientes:} informa o custo faltante e recusa a jogada.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E3 \'96 Alvo inv\'e1lido:} informa a restri\'e7\'e3o e recusa a jogada.\par
\pard\ql\sb240\sa120\b\fs26 CDU-08 \'97 EncerrarPartida\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 \'97 (inclu\'eddo por RealizarJogada e RenderSe; disparado tamb\'e9m pelo Temporizador)\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Finalizar a partida, apurar o resultado e atualizar os dados dos jogadores.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partida em andamento ou pausada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Partida com situa\'e7\'e3o "Encerrada", participa\'e7\'f5es com resultado registrado, totalizadores dos jogadores atualizados e, se ranqueada, pontua\'e7\'e3o da temporada atualizada.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema identifica o vencedor e o motivo do encerramento.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema grava o resultado nas duas participa\'e7\'f5es.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema altera a situa\'e7\'e3o da partida para "Encerrada" e grava a data e a hora do fim.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema incrementa os totalizadores de partidas e de vit\'f3rias dos jogadores.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema concede a experi\'eancia e os cristais correspondentes ao resultado.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab Se a partida for ranqueada, o sistema executa {\i AtualizarPontuacaoTemporada}.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta a tela de resultado aos dois jogadores.\par
\pard\ql\sb240\sa120\b\fs26 CDU-09 \'97 AtualizarPontuacaoTemporada\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 \'97 (inclu\'eddo por EncerrarPartida)\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Somar ou subtrair os pontos do jogador na temporada corrente e reenquadr\'e1-lo na divis\'e3o adequada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Existir temporada ativa e a partida ser ranqueada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Pontua\'e7\'e3o, acumuladores de vit\'f3rias e derrotas e divis\'e3o atualizados.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema localiza a temporada ativa.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema localiza ou cria a pontua\'e7\'e3o do jogador nessa temporada.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema soma 25 pontos ao vencedor e subtrai 15 pontos do perdedor, respeitando o piso de\par
\pard\qj\sa120 zero pontos.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema incrementa o acumulador de vit\'f3rias ou de derrotas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema reenquadra o jogador na divis\'e3o correspondente \'e0 nova pontua\'e7\'e3o.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema grava a pontua\'e7\'e3o.\par
\pard\ql\sb240\sa120\b\fs26 CDU-10 \'97 ConsultarRanking\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Jogador / Administrador\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Exibir a classifica\'e7\'e3o dos jogadores na temporada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Existir temporada cadastrada.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 \'97 (consulta)\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O usu\'e1rio solicita o ranking.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema seleciona a temporada ativa, ou a temporada escolhida pelo usu\'e1rio.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema ordena as pontua\'e7\'f5es em ordem decrescente de pontos e, em caso de empate, por maior\par
\pard\qj\sa120 n\'famero de vit\'f3rias.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta a p\'e1gina do ranking com posi\'e7\'e3o, apelido, divis\'e3o, pontos, vit\'f3rias e\par
\pard\qj\sa120 derrotas, destacando a linha do pr\'f3prio usu\'e1rio.\par
\pard\sa120\par
\pard\ql\sb240\sa120\b\fs28 ANEXO IV \'97 DIAGRAMA DE CLASSES DE AN\'c1LISE\b0\fs24\par
\pard\qj\sa120 Diagrama de Classes de An\'e1lise, anterior \'e0s decis\'f5es de projeto: sem visibilidade detalhada, sem tipos de dados, com as classes de associa\'e7\'e3o ainda representadas como tais, com o item de grupo {\f1\fs21 endereco} e o atributo multivalorado {\f1\fs21 telefone*} ainda embutidos em {\f1\fs21 Jogador} e sem as classes de apoio criadas no projeto.\par
