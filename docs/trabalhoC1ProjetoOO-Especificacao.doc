\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Manter os perfis de acesso e as fun\'e7\'f5es do sistema autorizadas a cada perfil.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Administrador autenticado com permiss\'e3o de administra\'e7\'e3o de seguran\'e7a.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Perfil de acesso inclu\'eddo, alterado ou exclu\'eddo.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O administrador solicita a manuten\'e7\'e3o de perfis de acesso.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema apresenta a rela\'e7\'e3o de perfis j\'e1 cadastrados.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O administrador seleciona incluir, alterar ou excluir.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab No caso de inclus\'e3o/altera\'e7\'e3o, o sistema solicita o nome e a descri\'e7\'e3o do perfil e apresenta a\par
\pard\qj\sa120 lista de fun\'e7\'f5es do sistema.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O administrador marca as fun\'e7\'f5es autorizadas e confirma.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema valida a unicidade do nome e grava o perfil e suas fun\'e7\'f5es.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Nome de perfil j\'e1 existente:} informa o erro e retorna ao passo 4.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E2 \'96 Exclus\'e3o de perfil em uso:} o sistema impede a exclus\'e3o e informa a quantidade de\par
\pard\qj\sa120 usu\'e1rios vinculados.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T04 \'97 EfetuarBackupJogadoresColecoes\b0\fs24\par
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 \b Campo\b0\cell
\pard\intbl\fs18 \b Conte\'fado\b0\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Ator principal}\cell
\pard\intbl\fs18 Temporizador (execu\'e7\'e3o autom\'e1tica) / Administrador (execu\'e7\'e3o manual)\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Objetivo}\cell
\pard\intbl\fs18 Copiar para meio secund\'e1rio os dados de jogadores, cole\'e7\'f5es, decks e pontua\'e7\'f5es, garantindo a recupera\'e7\'e3o em caso de falha.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b Pr\'e9-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Existir \'e1rea de destino configurada e dispon\'edvel.\cell
\row
\trowd\trgaph80\trleft0\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx4535\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9070
\pard\intbl\fs18 {\b P\'f3s-condi\'e7\'f5es}\cell
\pard\intbl\fs18 Arquivo de backup gerado, verificado e registrado no log de opera\'e7\'f5es.\cell
\row
\pard\sa120\par
\pard\qj\sa120 {\b Fluxo principal}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O temporizador dispara a rotina diariamente \'e0s 04:00, ou o administrador a solicita.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema bloqueia temporariamente as grava\'e7\'f5es nas tabelas envolvidas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema exporta os dados de jogadores, usu\'e1rios, cole\'e7\'f5es, decks, pontua\'e7\'f5es e temporadas.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema compacta e cifra o arquivo gerado.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema calcula e armazena o resumo de verifica\'e7\'e3o (hash) do arquivo.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema transfere o arquivo para o armazenamento de objetos na nuvem.\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab O sistema libera as grava\'e7\'f5es e registra o resultado no log.\par
\pard\qj\sa120 {\b Exce\'e7\'f5es}\par
\pard\fi-284\li709\sa0{\f2\'b7}\tab {\b E1 \'96 Falha de espa\'e7o ou de transfer\'eancia:} o sistema aborta, libera as grava\'e7\'f5es, registra a\par
\pard\qj\sa120 falha e notifica o administrador por e-mail.\par
\pard\ql\sb240\sa120\b\fs26 CDU-T05 \'97 GerarHistoricoPartidasEncerradas\b0\fs24\par
